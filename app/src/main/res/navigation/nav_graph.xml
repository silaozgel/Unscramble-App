<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.unscramble.app.ui.LoginFragment"
        android:label="Giriş Yap"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"/> <!-- Giriş yapınca geri tuşuyla tekrar logine dönmemek için -->
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.unscramble.app.ui.RegisterFragment"
        android:label="Kayıt Ol"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.unscramble.app.ui.HomeFragment"
        android:label="Ana Sayfa"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_UnscrambleGameFragment"
            app:destination="@id/UnscrambleGameFragment" />
        <!-- Bayrak oyunu için geçiş kısmı -->
        <action
            android:id="@+id/action_homeFragment_to_flagGameFragment"
            app:destination="@id/flagGameFragment" />
    </fragment>

    <!-- Bayrak oyunu fragmentı -->
    <fragment
        android:id="@+id/flagGameFragment"
        android:name="com.unscramble.app.ui.FlagGameFragment"
        android:label="Bayrak Bulma"
        tools:layout="@layout/fragment_flag_game" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.unscramble.app.ui.ProfileFragment"
        android:label="Profil"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/UnscrambleGameFragment"
        android:name="com.unscramble.app.ui.UnscrambleGameFragment"
        android:label="Unscramble"
        tools:layout="@layout/fragment_unscramble_game" />

</navigation>
